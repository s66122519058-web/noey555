{
  "info": {
    "name": "Zoo Visitors Report API - 8002",
    "description": "GET the local FastAPI response generated from the Data.go.th CSV.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List zoo visitor statistics",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{server}}/api/zoo-visitors",
          "host": ["{{server}}"],
          "path": ["api", "zoo-visitors"]
        }
      }
    }
  ],
  "variable": [{ "key": "server", "value": "http://127.0.0.1:8002" }]
}
